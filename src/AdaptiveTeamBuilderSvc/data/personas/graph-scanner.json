            "toDetailLevel": "extended",
            "signalsDisplay": "graph"
          }
        },
        {
          "action": "control.select",
          "contractIndex": 1,
          "meta": {
            "meaning": "chose-engagement-to-staff",
            "detailLevel": "extended",
            "signalsDisplay": "graph"
          }
        }
      ]
    },
    {
      "interactions": [
        {
          "action": "control.select",
          "contractIndex": 2,
          "meta": {
