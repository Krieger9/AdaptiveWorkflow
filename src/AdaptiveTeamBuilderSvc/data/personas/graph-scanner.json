            "to": "graph",
            "meaning": "switched-to-relative-graph-signals"
          }
        },
        {
          "action": "control.select",
          "contractIndex": 0,
          "meta": {
            "meaning": "chose-engagement-to-staff",
            "detailLevel": "summary",
            "signalsDisplay": "graph"
          }
        }
      ]
    },
    {
